# If chat and embedding use the same SiliconFlow-compatible key, this is enough.
SILICONFLOW_API_KEY=

# Optional: use a separate chat endpoint/key.
# ROUNDTABLE_CHAT_BASE_URL=https://api.siliconflow.cn/v1
# ROUNDTABLE_CHAT_API_KEY=
ROUNDTABLE_CHAT_MODEL=Qwen/Qwen3-30B-A3B
ROUNDTABLE_CHAT_WIRE_API=chat_completions

# Optional: use a separate embedding endpoint/key.
# ROUNDTABLE_EMBED_BASE_URL=https://api.siliconflow.cn/v1
# ROUNDTABLE_EMBED_API_KEY=
SILICONFLOW_EMBED_MODEL=Qwen/Qwen3-Embedding-8B
SILICONFLOW_EMBED_DIMENSIONS=4096
